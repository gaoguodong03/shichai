# Cursor / IDE debug logs
.cursor/debug*.log
backend/.cursor/debug*.log

# Agent 临时输出（错误文字等）
backend/data/agent-outputs/workspaces/*/错误文字.md

# 公开分享场景包（体积大，registry.json 可提交）
backend/data/scenario_shares/*.zip

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS metadata
.DS_Store

# Runtime/session artifacts (local only)
backend/data/users/*/agent-outputs/
backend/data/users/*/sessions/group_history_*.json
backend/data/users/*/sessions/group_sessions_meta.json
backend/logs/llm_trace.log
