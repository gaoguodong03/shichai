# Qwen API 配置
QWEN_API_KEY=sk-364125e5aa404a04bd3d3d01918ffde2
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 小模型响应更快：qwen-turbo / qwen2.5-turbo。大模型：qwen3-max / qwen-plus
QWEN_MODEL=qwen-turbo
# 若每次调用都 Retrying request：多为 DashScope 限流。可设 QWEN_REQUEST_DELAY_SEC=1（技能选择后延迟 1 秒再调 Agent）。调试时可设 QWEN_MAX_RETRIES=0 查看真实错误。
JENIYA_API_KEY=sk-nWGEUBdfuSeNJzrzuqUV0GLejlQDfiFFWD2vr9IKE5kO80BT

# 应用配置
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# MCP 配置
MCP_CONFIG_PATH=./config/mcp_servers.json

# Smithery 远程 MCP（如 text_to_pdf 文本转 PDF）需在 https://smithery.ai/account/api-keys 获取 API Key
SMITHERY_API_KEY=4dd6f77c-73f3-42d9-b0cd-011dd18789c5

# 高德地图 MCP：需在 https://lbs.amap.com/api/webservice/create-project-and-key 申请 Key
AMAP_MAPS_API_KEY=9b9fc27718d52a70c3d010210e0d58fa

# Exa 搜索 MCP：需在 https://dashboard.exa.ai/api-keys 获取 API Key
EXA_API_KEY=a1a5ab83-0160-4be1-a63c-74cd770c0c49

# Linkup MCP：需在 https://linkup.so 获取 API Key
LINKUP_API_KEY=9fa70c40-0152-418c-add6-e0e15b9b9d51


# 图标生成 Skill（app-icon-generator）脚本使用：ChatAnywhere 图像 API，POST，Bearer sk-xxx 或仅 sk-xxx
CHATANYWHERE_IMAGE_API_KEY=Bearer sk-ua2JHOQDSkIQ80xGukGnAf1NF9B16hMZvoO2iAMa6fw2PfFe


ZHIPU_WEB_SEARCH_API_KEY=4b8a7f73daba47ecae0313a2f367fdcd.4LKOsEupsBKbww3O

# Skills 存于 data/users/<邮箱>/skills（无仓库级目录；单测可选设 SKILLS_DIR）

OPENSANDBOX_DOMAIN="127.0.0.1:8091"
OPENSANDBOX_PROTOCOL="http"
OPENSANDBOX_USE_SERVER_PROXY=0

# 沙箱与线上一致：默认禁网 + 仅 run_skill_script* 经白名单出网；技能脚本仅走统一网关（无宿主机子进程兜底）
UNIFIED_TOOL_GATEWAY_ENABLED=1
SANDBOX_ALLOW_NETWORK=0
SANDBOX_NETWORK_TOOL_ALLOWLIST=run_skill_script
SANDBOX_ALLOWED_HOSTS=
SANDBOX_BASE_IMAGE=crpi-hzqv5l81v3ftz5jl.cn-beijing.personal.cr.aliyuncs.com/free4inno-yuanfang2025/dha:26.04
SKILL_SCRIPT_TIMEOUT=600
# 统一网关 asyncio 等待整段沙箱（建容器/首次 pip/执行脚本）；与 compose 一致，避免远端冷启动被 30s 误杀
SANDBOX_SCRIPT_GATEWAY_SLACK_MS=600000
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
OPENSANDBOX_REQUEST_TIMEOUT_SEC=900
SANDBOX_FIXED_MEMORY_MB=2048
