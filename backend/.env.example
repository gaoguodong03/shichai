# Copy to backend/.env for local development. Do not commit backend/.env.
# For 1Panel packaging, pack_1panel_backup.sh normalizes auth persistence paths
# to /app/backend/data so local host paths do not leak into the deployment.

QWEN_API_KEY=
# DashScope/Qwen API Key; keep empty until configured.

AUTH_SECRET=dev-secret-change-me
# Local development secret. Use a long random value in production.

ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Login token lifetime in minutes.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8100
# Allowed frontend origins.

AUTH_DB_PATH=/absolute/path/to/shichai/backend/config/auth_users.sqlite
# Local auth SQLite path. Prefer an absolute path to avoid cwd-dependent backend/backend/config mistakes.

SHUTONG_USER_DATA_ROOT=/absolute/path/to/shichai/backend/data/users
# Local per-user resource data root.

QWEN_REQUEST_TIMEOUT=60
# Single LLM HTTP request timeout in seconds.

QWEN_REQUEST_TIMEOUT_MAX=0
# 0 means no extra cap; set 30 to force a 30s maximum.

QWEN_MAX_RETRIES=0
# 0 means fail once and do not retry.

# Optional sandbox settings for local OpenSandbox.
# OPENSANDBOX_DOMAIN=127.0.0.1:8091
# OPENSANDBOX_PROTOCOL=http
# OPENSANDBOX_USE_SERVER_PROXY=0
# SANDBOX_ALLOW_NETWORK=0
