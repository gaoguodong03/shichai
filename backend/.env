# Qwen API 配置
QWEN_API_KEY=sk-364125e5aa404a04bd3d3d01918ffde2
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 小模型响应更快：qwen-turbo / qwen2.5-turbo。大模型：qwen3-max / qwen-plus
QWEN_MODEL=qwen-turbo
# 若每次调用都 Retrying request：多为 DashScope 限流。可设 QWEN_REQUEST_DELAY_SEC=1（技能选择后延迟 1 秒再调 Agent）。调试时可设 QWEN_MAX_RETRIES=0 查看真实错误。
JENIYA_API_KEY=sk-nWGEUBdfuSeNJzrzuqUV0GLejlQDfiFFWD2vr9IKE5kO80BT

# 应用配置
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# MCP 配置
MCP_CONFIG_PATH=./config/mcp_servers.json

# Smithery 远程 MCP（如 text_to_pdf 文本转 PDF）需在 https://smithery.ai/account/api-keys 获取 API Key
SMITHERY_API_KEY=4dd6f77c-73f3-42d9-b0cd-011dd18789c5

