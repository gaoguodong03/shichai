{
  "crawl_and_store.py": {
    "description": "抓取网页并落盘保存 page.html / text.md / meta.json，支持通过 stdin input_json 传入 URL。",
    "timeout_sec": 60,
    "input_schema": {
      "type": "object"
    },
    "examples": [
      {
        "script_path": "crawl_and_store.py",
        "input_json": {
          "urls": ["https://example.com"]
        }
      },
      {
        "script_path": "crawl_and_store.py",
        "input_json": {
          "url": "https://example.com"
        }
      }
    ]
  }
}
