[
  {
    "id": "linkup",
    "name": "Linkup抓取网页",
    "enabled": true,
    "transport": {
      "type": "http",
      "url": "https://mcp.linkup.so/mcp?apiKey=${LINKUP_API_KEY}",
      "base_url": "https://mcp.linkup.so/mcp?apiKey=${LINKUP_API_KEY}"
    },
    "metadata": {
      "description": "Linkup 远程 MCP：linkup-search 搜索、linkup-fetch 抓取网页。需在 .env 中设置 LINKUP_API_KEY。（默认禁用：启动时外部连接不稳定会拖慢/阻塞初始化；需要时可再启用）"
    }
  },
  {
    "id": "exa",
    "name": "Exa 搜索",
    "enabled": true,
    "transport": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}",
      "base_url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}"
    },
    "metadata": {
      "description": "Exa 远程 MCP：web_search_exa 搜索、get_code_context_exa 代码检索等。需在 .env 中设置 EXA_API_KEY。（默认禁用：启动时外部连接不稳定会拖慢/阻塞初始化；需要时可再启用）"
    }
  }
]
