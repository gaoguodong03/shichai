# 复制为 backend/.env 后再启动

# 必填：至少配置一个模型供应商 Key
QWEN_API_KEY=your_qwen_api_key

# 强烈建议：生产环境务必更换为长随机串
AUTH_SECRET=please_change_to_a_long_random_secret

# 按你的 1Panel 对外地址修改（支持多个，逗号分隔）
CORS_ORIGINS=http://127.0.0.1:8100

# 沙箱（与 docker-compose.1panel.yml / 本地 docker-compose.yml 对齐；裸机 python -m app.main 时也应写入 backend/.env）
# UNIFIED_TOOL_GATEWAY_ENABLED=1
# SANDBOX_ALLOW_NETWORK=0
# SANDBOX_NETWORK_TOOL_ALLOWLIST=run_skill_script
# SANDBOX_ALLOWED_HOSTS=
# OPENSANDBOX_DOMAIN=opensandbox-server:8090
# OPENSANDBOX_PROTOCOL=http
# OPENSANDBOX_USE_SERVER_PROXY=1
